# Environment: test | development | production
NODE_ENV=development

# ===== DATABASE CONFIGURATION =====
# Automatically determined by NODE_ENV:

# TEST ENVIRONMENT
# NODE_ENV=test
# → Uses in-memory SQLite (:memory:)
# → Perfect for isolated test runs
# → No additional config needed

# DEVELOPMENT ENVIRONMENT (default)
# NODE_ENV=development
# → Uses file-based SQLite at ./database/data-dev.db
# → Can override path with DB_PATH
DB_PATH=./database/data-dev.db

# PRODUCTION ENVIRONMENT
# NODE_ENV=production
# → Uses PostgreSQL with URI and credentials
# → Requires DB_URI and DB_PASSWORD
# DB_URI=postgresql://username:password@host:5432/billing_api_prod
# DB_PASSWORD=your_secure_password

# ===== SERVER CONFIGURATION =====
PORT=3000

# ===== JWT CONFIGURATION =====
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=3600s

# CORS CONFIGURATION (optional)
# ALLOWED_ORIGINS=* # Comma-separated list of allowed origins for CORS (e.g., http://localhost:3000,http://example.com)